{
  "manifest_version": 3,
  "name": "NIKKE 装备洗词条期望计算器",
  "short_name": "NIKKE洗词条",
  "version": "1.0.1",
  "description": "适配 Firefox 的 NIKKE 企业装洗词条精确 MDP 期望计算器，支持通过 Blablalink Cookie 同步角色装备与四装备词条汇总导入。",
  "browser_specific_settings": {
    "gecko": {
      "id": "nikke-equip-calc@nikkelines.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "NIKKE 洗词条期望计算器",
    "default_popup": "sidebar.html?mode=popup",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_title": "NIKKE 洗词条期望计算器",
    "default_panel": "sidebar.html?mode=sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.blablalink.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  }
}
